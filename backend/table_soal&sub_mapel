-- ============================================
-- Create ENUM for mapel category (if not exists)
-- ============================================
DO $$ BEGIN
    CREATE TYPE mapel_category_enum AS ENUM ('ipa', 'ips', 'bahasa', 'umum');
EXCEPTION
    WHEN duplicate_object THEN null;
END $$;

-- ============================================
-- Table: jenis_mapel
-- ============================================
CREATE TABLE IF NOT EXISTS jenis_mapel (
    id_mapel SERIAL PRIMARY KEY,
    nama VARCHAR(100) NOT NULL,
    slug VARCHAR(100) NOT NULL UNIQUE,
    deskripsi TEXT,
    icon VARCHAR(255),
    category mapel_category_enum DEFAULT 'umum',
    color VARCHAR(20) DEFAULT '#012f72',
    is_active BOOLEAN DEFAULT true,
    created_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Create indexes for jenis_mapel
CREATE INDEX IF NOT EXISTS idx_jenis_mapel_slug ON jenis_mapel(slug);
CREATE INDEX IF NOT EXISTS idx_jenis_mapel_category ON jenis_mapel(category);
CREATE INDEX IF NOT EXISTS idx_jenis_mapel_is_active ON jenis_mapel(is_active);

-- ============================================
-- Table: sub_bab_mapel
-- ============================================
CREATE TABLE IF NOT EXISTS sub_bab_mapel (
    id_sub_bab SERIAL PRIMARY KEY,
    id_mapel INT NOT NULL,
    nama_sub_bab VARCHAR(200) NOT NULL,
    kode_sub_bab VARCHAR(50) UNIQUE NOT NULL,
    bab_utama VARCHAR(200),
    urutan INT,
    deskripsi TEXT,
    tujuan VARCHAR(255),
    contoh VARCHAR(255),
    materi TEXT,
    video VARCHAR(255),
    created_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_mapel) REFERENCES jenis_mapel(id_mapel) ON DELETE CASCADE
);

-- Create indexes for sub_bab_mapel
CREATE INDEX IF NOT EXISTS idx_sub_bab_mapel_id_mapel ON sub_bab_mapel(id_mapel);
CREATE INDEX IF NOT EXISTS idx_sub_bab_mapel_bab_utama ON sub_bab_mapel(bab_utama);

-- ============================================
-- Table: soal
-- ============================================
CREATE TABLE IF NOT EXISTS soal (
    id_soal SERIAL PRIMARY KEY,
    id_sub_bab INT NOT NULL,
    kode_soal VARCHAR(50) UNIQUE NOT NULL,
    tipe_soal VARCHAR(20) NOT NULL CHECK (tipe_soal IN ('pilihan_ganda', 'essay', 'benar_salah', 'menjodohkan', 'isian_singkat')),
    pertanyaan TEXT NOT NULL,
    pilihan_a TEXT,
    pilihan_b TEXT,
    pilihan_c TEXT,
    pilihan_d TEXT,
    pilihan_e TEXT,
    jawaban_benar VARCHAR(10),
    pembahasan TEXT,
    bobot_nilai INT DEFAULT 1,
    waktu_pengerjaan INT,
    gambar_soal VARCHAR(255),
    created_by INT,
    created_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_sub_bab) REFERENCES sub_bab_mapel(id_sub_bab) ON DELETE CASCADE
);

-- Create indexes for soal
CREATE INDEX IF NOT EXISTS idx_soal_id_sub_bab ON soal(id_sub_bab);
CREATE INDEX IF NOT EXISTS idx_soal_tipe_soal ON soal(tipe_soal);

-- ============================================
-- Function untuk auto update updated_at
-- ============================================
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- ============================================
-- Triggers untuk auto update updated_at
-- ============================================
DROP TRIGGER IF EXISTS update_jenis_mapel_updated_at ON jenis_mapel;
CREATE TRIGGER update_jenis_mapel_updated_at
BEFORE UPDATE ON jenis_mapel
FOR EACH ROW
EXECUTE FUNCTION update_updated_at_column();

DROP TRIGGER IF EXISTS update_sub_bab_mapel_updated_at ON sub_bab_mapel;
CREATE TRIGGER update_sub_bab_mapel_updated_at
BEFORE UPDATE ON sub_bab_mapel
FOR EACH ROW
EXECUTE FUNCTION update_updated_at_column();

DROP TRIGGER IF EXISTS update_soal_updated_at ON soal;
CREATE TRIGGER update_soal_updated_at
BEFORE UPDATE ON soal
FOR EACH ROW
EXECUTE FUNCTION update_updated_at_column();

